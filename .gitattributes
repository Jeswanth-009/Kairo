# Normalize line endings: LF in the repo for text, Git converts as configured
# per platform. Shell scripts that must run in bash always use LF.
* text=auto

*.sh          text eol=lf
*.ps1         text eol=crlf
*.bat         text eol=crlf

# Windows resource files
*.rc          text eol=crlf

# Rust / web sources stay LF
*.rs          text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.css         text eol=lf
*.json        text eol=lf
*.toml        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.sql         text eol=lf
*.html        text eol=lf

# Binaries — never normalize
*.png         binary
*.jpg         binary
*.ico         binary
*.icns        binary
*.pdf         binary
*.db          binary
*.exe         binary
*.woff2       binary
